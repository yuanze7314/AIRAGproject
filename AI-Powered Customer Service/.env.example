DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=20000
DEEPSEEK_MAX_TOKENS=4000

# Set to 1 to force the local deterministic fallback without calling DeepSeek.
DEEPSEEK_DISABLED=0

# Optional generic aliases. DeepSeek-specific variables above take priority for clarity.
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE_URL=
LLM_TIMEOUT_MS=
LLM_DISABLED=0

# Local RAG grounding thresholds.
RAG_VECTOR_STORE=memory
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE=knowledge_chunks
RAG_RERANKER=local
CROSS_ENCODER_API_URL=http://127.0.0.1:8010/rerank
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_TIMEOUT_MS=10000
CROSS_ENCODER_DISABLED=0
BAAI_RERANKER_MODEL=BAAI/bge-reranker-base
BAAI_RERANKER_HOST=127.0.0.1
BAAI_RERANKER_PORT=8010
BAAI_RERANKER_DEVICE=cpu
BAAI_RERANKER_BATCH_SIZE=8
BAAI_RERANKER_MAX_LENGTH=512
RAG_GENERAL_MIN_SCORE=0.35
RAG_GENERAL_MIN_MARGIN=0.05
RAG_GENERAL_HIGH_CONFIDENCE_BYPASS=0.9
RAG_AFTER_SALES_MIN_SCORE=0.55
RAG_AFTER_SALES_MIN_MARGIN=0.03
RAG_AFTER_SALES_HIGH_CONFIDENCE_BYPASS=0.9
